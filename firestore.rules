rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Configuración pública del cronograma y profesores
    // Cualquier persona puede leer, pero solo administradores autenticados pueden modificar
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Registro de visitas
    // Cualquier usuario de internet puede crear un registro (logVisit)
    // Solo los administradores autenticados pueden leer el historial para las estadísticas
    match /visits/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Gestión de usuarios
    // Solo administradores autenticados pueden leer o crear/borrar nuevos usuarios
    match /users/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
